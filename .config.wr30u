#
# Xiaomi / Redmi WR30U（MediaTek MT7981B / aarch64 / 256M RAM / 128M SPI-NAND）
# 当前 coolsnowwolf/lede master 已是 24.10.5 基线：mediatek/filogic 内核 6.18，
# 默认包改成 firewall4 + nftables-json（同时保留 iptables 兼容层）。
# rootfs 走 ubi 里的 squashfs，ubi 分区 112MiB，压缩后装得下未压缩的 mihomo。
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u=y

#
# LuCI 基础
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

#
# 代理方案：nikki（mihomo 的 LuCI 前端）
#
# ⚠️ 这台设备实际跑的是 nikki，不是 ssr-plus。之前这份配置编的是
# ssr-plus + xray + hysteria + sslocal + 19MB geoip.dat，而设备上
# 这些一个都没在跑（ps 里只有 mihomo），等于白占 ~60MB rootfs。
#
# 去掉 UPX 后 mihomo 从 12.8MB 涨到 57.5MB 原始体积（squashfs 压缩后
# ≈16.5MB，净增仅 ~3.7MB），砍掉这些不用的内核正好腾出空间。
#
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_mihomo=y

# ssr-plus 全家桶：本机不用，全部排除
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Mihomo is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Http_Proxy is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_Nftables_Transparent_Proxy is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_v2ray-geoip is not set
# CONFIG_PACKAGE_v2ray-geosite is not set
# CONFIG_PACKAGE_trojan is not set
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-local is not set
# CONFIG_PACKAGE_chinadns-ng is not set
# CONFIG_PACKAGE_dns2tcp is not set
# CONFIG_PACKAGE_microsocks is not set
# CONFIG_PACKAGE_ipt2socks is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_v2ray-core is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_naiveproxy is not set
# CONFIG_PACKAGE_shadow-tls is not set
# CONFIG_PACKAGE_kcptun-client is not set

#
# nikki 依赖的 nftables / dnsmasq 组件（fw4 基线）
#
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y

#
# 常用工具
#
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_lyaml=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_flock=y
CONFIG_PACKAGE_nping=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_htop=y

#
# LuCI 主题
#
# bootstrap 在 coolsnowwolf/luci feed 里，直接选上作为兜底。
# carbon（Apple 风格）不在 lede 的任何 feed 里 —— 写 CONFIG_PACKAGE_luci-theme-carbon=y
# 会被 defconfig 静默丢弃，所以改用离线 ipk：
#   files/opt/pkgs/luci-theme-carbon.ipk  →  /opt/pkgs/
#   files/etc/uci-defaults/97-carbon-theme →  首启 opkg 安装并设为默认
# ipk 来源：github.com/mrjoechen/luci-theme-carbon releases v1.1.8
# 依赖 flock / curl / ca-bundle 已在上面选中。
#
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-carbon is not set

#
# zram：压缩 swap，给 231MB / 0-swap 的机器一个缓冲垫
#
# 背景：mihomo 常驻 60MB，MemAvailable 常年 8-12MB，流量尖峰直接触发
# 全局 OOM（实测一晚上 17 次）。加 zram 后内核有地方换出冷页，不再
# 一有峰值就杀进程。
#
# kmod-zram 的 KCONFIG 打开 CONFIG_ZRAM + CONFIG_ZSMALLOC（见
# feeds/packages/kernel/modules/other.mk 的 KernelPackage/zram）。
# zram-swap 是用户态初始化脚本，DEPENDS 里已经带 +kmod-zram。
#
# ⚠️ 压缩后端：lede other.mk 的 KERNEL_ZRAM_BACKEND_* 选择块被 `if LINUX_6_12`
# 包着，而本目标是 6.18 内核 —— 那段原本不会生效，内核会退化成没有任何
# 压缩后端（generic/config-6.18 里 ZRAM_DEF_COMP="unset-value"），zram 起不来。
# diy-part2-wr30u.sh 已把门槛放宽到 `LINUX_6_12 || LINUX_6_18 || LINUX_7_3`，
# 选择块正常生效后，下面两项才有意义。
#
# 不选 zstd：它压缩比更高但 CPU 开销大得多。MT7981B 是双核 A53，
# 路由器上 swap I/O 要的是低延迟，lzo-rle 是 OpenWrt 的默认也是最合适的。
#
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
# 不写 CONFIG_KERNEL_ZRAM / CONFIG_KERNEL_ZSMALLOC：
# 这两个符号没在 config/Config-kernel.in 里声明，写了会被 defconfig 丢弃；
# 且 KernelPackage/zram 的 KCONFIG 已经会打开它们，重复写反而可能把模块
# 顶成内置。只写后端与默认算法这两项即可。
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZORLE=y
# CONFIG_KERNEL_ZRAM_DEBUG is not set
# CONFIG_KERNEL_ZRAM_WRITEBACK is not set

# busybox 侧 zram-swap 的 DEPENDS 需要这几个 applet
CONFIG_BUSYBOX_CONFIG_MKSWAP=y
CONFIG_BUSYBOX_CONFIG_SWAPON=y
CONFIG_BUSYBOX_CONFIG_SWAPOFF=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SWAPON_PRI=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SWAPON_DISCARD=y
